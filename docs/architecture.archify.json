  "cards": [
    {
      "dot": "emerald",
      "title": "Pipeline",
      "items": [
        "Webhook signature verified, event stored before 200 OK",
        "Lead fetched with the page token, routed by form or page default",
        "One delivery per destination, Idempotency-Key, 7 attempts over ~1.5 days"
      ]
    },
    {
      "dot": "violet",
      "title": "Periodic jobs (beat)",
      "items": [
        "reconcile_leads every 15 min, sweep_stuck_work every 5 min",
        "sync_forms and check_silence hourly; check_pages and purge_old_data daily",
        "heartbeat every minute, read by /health/"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
      "items": [
        "Secrets Fernet-encrypted at rest",
        "SSRF guard re-checks the connected IP (DNS rebinding)",
        "Late results after a lost lease are discarded"
      ]
    }
  ]
