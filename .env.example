# --- Required ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it after secrets are stored: they would become unreadable.
LEADHOOK_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://leads.example.com
ALLOWED_HOSTS=leads.example.com

# --- Optional ---
DJANGO_DEBUG=false
# Set to false only for local testing over plain HTTP.
SECURE_SSL_REDIRECT=true
# docker-compose sets DATABASE_URL and REDIS_URL itself; these values matter outside Compose.
# For local development without Docker remove DATABASE_URL (SQLite) and use
# REDIS_URL=redis://localhost:6379/0 (the host name "redis" only resolves inside Compose).
DATABASE_URL=postgres://leadhook:leadhook@postgres:5432/leadhook
REDIS_URL=redis://redis:6379/0
# Check https://developers.facebook.com/docs/graph-api/changelog for the latest version.
META_GRAPH_VERSION=v26.0
# Allow destinations on private networks (e.g. n8n in the same Docker network).
ALLOW_PRIVATE_DESTINATIONS=false
LOG_LEVEL=info
# Alert emails (failed deliveries, unrouted leads, page/token problems, silence).
# EMAIL_URL examples: smtp+tls://user:password@smtp.example.com:587 — default prints to the log.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=leadhook@example.com
ALERT_EMAILS=ops@example.com
# Days after which lead answers, payloads and request/response bodies are erased.
LEAD_RETENTION_DAYS=90
# Alert when a page that usually gets leads has had none for this many hours.
SILENCE_ALERT_HOURS=24
# CA bundle for destinations served with a private certificate authority.
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
